<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#DCE6FF"
                android:centerColor="#EEF3FF"
                android:endColor="#F4F6FC" />
            <corners android:bottomLeftRadius="30dp" android:bottomRightRadius="30dp" />
        </shape>
    </item>
    <item android:left="60dp" android:top="-90dp" android:right="-140dp" android:bottom="60dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:startColor="#4D9BB4FF"
                android:endColor="#009BB4FF" />
        </shape>
    </item>
    <item android:left="-120dp" android:top="90dp" android:right="120dp" android:bottom="-60dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#2E7C5CFF"
                android:endColor="#007C5CFF" />
        </shape>
    </item>
</layer-list>
