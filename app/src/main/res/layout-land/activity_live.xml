<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2.5 landscape: 视频在左、控制在右。全部 view id 与竖屏布局一致，LiveActivity 不用改。
     视频容器仍在 ScrollView 之外；TextureView 由代码创建、不带 background。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/liveRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="horizontal" android:padding="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:orientation="vertical">
        <!-- v1.2.6: light-theme top bar (same as portrait) — white +
             dark text, actions in primary blue; no more black bar. -->
        <!-- v1.2.9: id added so fullscreen can hide the whole bar. -->
        <LinearLayout android:id="@+id/topBarLive" android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@color/white" android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button android:id="@+id/btnBackLive" android:layout_width="48dp"
                android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/live_back" android:textColor="@color/text_primary"
                android:textSize="26sp" android:textStyle="bold" android:textAllCaps="false" />
            <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center"
                android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"
                style="@style/TextAppearance.XiaoGuYun.Title" />
            <Button android:id="@+id/btnShareLive" android:layout_width="wrap_content"
                android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:text="@string/live_share" android:textColor="@color/primary"
                android:textSize="14sp" android:textAllCaps="false" />
            <Button android:id="@+id/btnSettingsLive" android:layout_width="wrap_content"
                android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:text="@string/live_settings" android:textColor="@color/primary"
                android:textSize="14sp" android:textAllCaps="false" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/border" />
        <!-- v1.2.7: the video box is wrapped so the player can size the
             container to the video's aspect and centre it (no black
             bars inside the video box; leftover space is page bg). -->
        <FrameLayout android:id="@+id/videoWrapper" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="8dp">
            <FrameLayout android:id="@+id/videoContainer" android:layout_width="match_parent"
                android:layout_height="220dp" android:layout_gravity="center"
                android:background="@color/video_black" android:gravity="center" />
            <!-- v1.2.9: fullscreen overlay — back (top-left), frosted-glass
                 close X (top-right), and a bottom row of small round
                 action buttons (LED / snapshot / record / mute / intercom).
                 Visible only in fullscreen; hidden otherwise. -->
            <FrameLayout android:id="@+id/fsOverlay" android:layout_width="match_parent"
                android:layout_height="match_parent" android:visibility="gone">
                <Button android:id="@+id/btnFsBack" android:layout_width="48dp"
                    android:layout_height="48dp" android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_circle_white"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:text="@string/live_back" android:textSize="26sp" android:textStyle="bold"
                    android:textAllCaps="false" android:textColor="@color/text_primary" />
                <Button android:id="@+id/btnFsClose" android:layout_width="48dp"
                    android:layout_height="48dp" android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_glass"
                    android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:text="✕" android:textSize="20sp" android:textStyle="bold"
                    android:textAllCaps="false" android:textColor="@color/white" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnFsLed" android:layout_width="56dp"
                        android:layout_height="56dp" android:layout_margin="6dp"
                        android:background="@drawable/bg_circle_white"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:text="灯光" android:textSize="12sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnFsSnapshot" android:layout_width="56dp"
                        android:layout_height="56dp" android:layout_margin="6dp"
                        android:background="@drawable/bg_circle_white"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:text="截图" android:textSize="12sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnFsRecord" android:layout_width="56dp"
                        android:layout_height="56dp" android:layout_margin="6dp"
                        android:background="@drawable/bg_circle_white"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:text="录像" android:textSize="12sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnFsMute" android:layout_width="56dp"
                        android:layout_height="56dp" android:layout_margin="6dp"
                        android:background="@drawable/bg_circle_white"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:text="静音" android:textSize="12sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnFsIntercom" android:layout_width="56dp"
                        android:layout_height="56dp" android:layout_margin="6dp"
                        android:background="@drawable/bg_circle_white"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:text="对讲" android:textSize="12sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
        <TextView android:id="@+id/tvLiveStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="@string/connecting" android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
    <LinearLayout android:id="@+id/controlsRail" android:layout_width="320dp" android:layout_height="match_parent"
        android:layout_marginStart="12dp" android:orientation="vertical">
    <ScrollView android:id="@+id/scrollControls" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnPauseLive" android:layout_width="0dp"
                    android:layout_height="40dp" android:layout_weight="1" android:layout_margin="4dp"
                    android:background="@drawable/bg_btn_white_capsule"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:text="@string/live_pause" android:textSize="14sp"
                    android:textAllCaps="false" android:textColor="@color/text_primary" />
                <Button android:id="@+id/btnDefinition" android:layout_width="0dp"
                    android:layout_height="40dp" android:layout_weight="1" android:layout_margin="4dp"
                    android:background="@drawable/bg_btn_white_capsule"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:text="高清" android:textSize="14sp"
                    android:textAllCaps="false" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnMute" android:layout_width="0dp"
                    android:layout_height="40dp" android:layout_weight="1" android:layout_margin="4dp"
                    android:background="@drawable/bg_btn_white_capsule"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:text="@string/mute" android:textSize="14sp"
                    android:textAllCaps="false" android:textColor="@color/text_primary" />
                <Button android:id="@+id/btnFullscreen" android:layout_width="0dp"
                    android:layout_height="40dp" android:layout_weight="1" android:layout_margin="4dp"
                    android:background="@drawable/bg_btn_white_capsule"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:text="全屏" android:textSize="14sp"
                    android:textAllCaps="false" android:textColor="@color/text_primary" />
            </LinearLayout>
            <!-- v1.2.7: 三通道快照条（全景 / 特写 / 双画面），见竖屏布局注释。 -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/dual_channel"
                android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/channelRow" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:orientation="horizontal">
                <LinearLayout android:id="@+id/chanItemTop" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="4dp" android:orientation="vertical">
                    <FrameLayout android:id="@+id/chanThumbTop" android:layout_width="match_parent"
                        android:layout_height="64dp" android:background="@drawable/bg_preview">
                        <ImageView android:id="@+id/ivChanTop" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:scaleType="fitCenter" />
                        <TextView android:id="@+id/tvChanTopEmpty" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:gravity="center"
                            android:text="暂无画面" android:textSize="11sp"
                            android:textColor="#8A8F9C" />
                    </FrameLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:gravity="center"
                        android:text="全景相机" android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <LinearLayout android:id="@+id/chanItemBottom" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
                    android:orientation="vertical">
                    <FrameLayout android:id="@+id/chanThumbBottom" android:layout_width="match_parent"
                        android:layout_height="64dp" android:background="@drawable/bg_preview">
                        <ImageView android:id="@+id/ivChanBottom" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:scaleType="fitCenter" />
                        <TextView android:id="@+id/tvChanBottomEmpty" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:gravity="center"
                            android:text="暂无画面" android:textSize="11sp"
                            android:textColor="#8A8F9C" />
                    </FrameLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:gravity="center"
                        android:text="特写相机" android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
                <LinearLayout android:id="@+id/chanItemFull" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="4dp" android:orientation="vertical">
                    <FrameLayout android:id="@+id/chanThumbFull" android:layout_width="match_parent"
                        android:layout_height="64dp" android:background="@drawable/bg_preview">
                        <ImageView android:id="@+id/ivChanFull" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:scaleType="fitCenter" />
                        <TextView android:id="@+id/tvChanFullEmpty" android:layout_width="match_parent"
                            android:layout_height="match_parent" android:gravity="center"
                            android:text="暂无画面" android:textSize="11sp"
                            android:textColor="#8A8F9C" />
                    </FrameLayout>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:gravity="center"
                        android:text="双画面" android:textSize="12sp"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/tools_row"
                android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btnPlayback" android:layout_width="wrap_content"
                        android:layout_height="40dp" android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip"
                        android:minWidth="0dp" android:minHeight="0dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:text="@string/playback" android:textSize="14sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnIntercom" android:layout_width="wrap_content"
                        android:layout_height="40dp" android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_btn_primary_capsule"
                        android:minWidth="0dp" android:minHeight="0dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:text="@string/intercom" android:textSize="14sp" android:textStyle="bold"
                        android:textAllCaps="false" android:textColor="@color/white" />
                    <Button android:id="@+id/btnSnapshot" android:layout_width="wrap_content"
                        android:layout_height="40dp" android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip"
                        android:minWidth="0dp" android:minHeight="0dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:text="截图" android:textSize="14sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnRecord" android:layout_width="wrap_content"
                        android:layout_height="40dp" android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip"
                        android:minWidth="0dp" android:minHeight="0dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:text="本地录像" android:textSize="14sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnAlbumLive" android:layout_width="wrap_content"
                        android:layout_height="40dp" android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip"
                        android:minWidth="0dp" android:minHeight="0dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:text="@string/tool_album" android:textSize="14sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnFlipLive" android:layout_width="wrap_content"
                        android:layout_height="40dp" android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip"
                        android:minWidth="0dp" android:minHeight="0dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:text="画面翻转" android:textSize="14sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnFillLight" android:layout_width="wrap_content"
                        android:layout_height="40dp" android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip"
                        android:minWidth="0dp" android:minHeight="0dp"
                        android:paddingStart="16dp" android:paddingEnd="16dp"
                        android:text="补光灯：查询中…" android:textSize="14sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <!-- v1.2.9: 云台入口已删——云台常驻页面底部，工具栏里再放一个是重复。 -->
                </LinearLayout>
            </HorizontalScrollView>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/more_title" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <Button android:id="@+id/btnTrack" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="12dp"
                    android:background="@drawable/bg_btn_white"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:text="智能追踪：查询中…" android:textSize="14sp"
                    android:textAllCaps="false" android:textColor="@color/text_primary" />
                <Button android:id="@+id/btnLens" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_white"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:text="切换镜头" android:textSize="14sp"
                    android:textAllCaps="false" android:textColor="@color/text_primary" />
                <Button android:id="@+id/btnRetryLive" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_white"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:text="@string/retry" android:textSize="14sp"
                    android:textAllCaps="false" android:textColor="@color/text_primary" />
                <Button android:id="@+id/btnCopyAddr" android:layout_width="match_parent"
                    android:layout_height="48dp" android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_white"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:text="复制直播地址（诊断用）" android:textSize="14sp"
                    android:textAllCaps="false" android:textColor="@color/text_primary" />
            </LinearLayout>
            <!-- v1.2.10: 云台放回同一个 container（右侧控制区里和其他组件
                 在一个 ScrollView 里）；不再单独占一个底部 dock。 -->
            <LinearLayout android:id="@+id/ptzCard" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/ptz_title" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/ptz_hint"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp"
                    android:gravity="center">
                    <View android:layout_width="56dp" android:layout_height="56dp"
                        android:layout_margin="4dp" />
                    <Button android:id="@+id/btnUp" android:layout_width="56dp"
                        android:layout_height="56dp" android:layout_margin="4dp"
                        android:background="@drawable/bg_circle_white"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:text="@string/ptz_up" android:textSize="16sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <View android:layout_width="56dp" android:layout_height="56dp"
                        android:layout_margin="4dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center">
                    <Button android:id="@+id/btnLeft" android:layout_width="56dp"
                        android:layout_height="56dp" android:layout_margin="4dp"
                        android:background="@drawable/bg_circle_white"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:text="@string/ptz_left" android:textSize="16sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <Button android:id="@+id/btnResetPtz" android:layout_width="56dp"
                        android:layout_height="56dp" android:layout_margin="4dp"
                        android:background="@drawable/bg_circle_primary"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:text="@string/ptz_reset" android:textSize="12sp"
                        android:textAllCaps="false" android:textColor="@color/white" />
                    <Button android:id="@+id/btnRight" android:layout_width="56dp"
                        android:layout_height="56dp" android:layout_margin="4dp"
                        android:background="@drawable/bg_circle_white"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:text="@string/ptz_right" android:textSize="16sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center">
                    <View android:layout_width="56dp" android:layout_height="56dp"
                        android:layout_margin="4dp" />
                    <Button android:id="@+id/btnDown" android:layout_width="56dp"
                        android:layout_height="56dp" android:layout_margin="4dp"
                        android:background="@drawable/bg_circle_white"
                        android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:text="@string/ptz_down" android:textSize="16sp"
                        android:textAllCaps="false" android:textColor="@color/text_primary" />
                    <View android:layout_width="56dp" android:layout_height="56dp"
                        android:layout_margin="4dp" />
                </LinearLayout>
                <!-- v1.2.8: 云台预置点（航位推算，存本机）。点一个预置点先
                     复位再按记下的方向时长自动转过去；智能追踪开着时
                     位置可能不准。 -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="@string/preset_title"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="@string/preset_hint"
                    android:textColor="@color/text_secondary" android:textSize="12sp" />
                <Button android:id="@+id/btnSavePreset" android:layout_width="match_parent"
                    android:layout_height="40dp" android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_white"
                    android:minWidth="0dp" android:minHeight="0dp"
                    android:text="@string/preset_save" android:textSize="14sp"
                    android:textAllCaps="false" android:textColor="@color/text_primary" />
                <LinearLayout android:id="@+id/presetListContainer" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:id="@+id/tvPresetTrackHint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="@string/preset_track_hint" android:textColor="#FFB300"
                    android:textSize="12sp" android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
