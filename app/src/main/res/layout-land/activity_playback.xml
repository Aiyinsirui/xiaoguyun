<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2.5 landscape: video on the left, controls + record list on the right.
     All view ids match the portrait layout. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="horizontal" android:padding="12dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"
            android:textColor="@color/text_primary" android:text="回放" />
        <FrameLayout android:id="@+id/videoContainer" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:background="@color/video_black" android:gravity="center" />
        <TextView android:id="@+id/tvStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="@string/connecting" android:textSize="12sp"
            android:textColor="@color/text_secondary" />
        <SeekBar android:id="@+id/sbTimeline" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp" android:max="86400"
            android:progressTint="@color/primary" android:thumbTint="@color/primary" />
        <TextView android:id="@+id/tvPosition" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="--:--:--"
            android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <Button android:id="@+id/btnPause" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp"
                android:background="@drawable/bg_btn_white_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="暂停" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnResume" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp"
                android:background="@drawable/bg_btn_white_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="继续" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnBack10" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp"
                android:background="@drawable/bg_btn_white_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="-10 秒" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnFwd10" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp"
                android:background="@drawable/bg_btn_white_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="+10 秒" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="320dp" android:layout_height="match_parent"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnCloud" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp"
                android:background="@drawable/bg_btn_white_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="云回放" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnSd" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp"
                android:background="@drawable/bg_btn_white_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="SD 回放" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/text_primary" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnPrevDay" android:layout_width="wrap_content"
                android:layout_height="48dp" android:background="@drawable/bg_btn_white_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="‹ 前一天" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/text_primary" />
            <EditText android:id="@+id/etDate" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
                android:background="@drawable/bg_input" android:paddingStart="12dp" android:paddingEnd="12dp"
                android:hint="日期 yyyy-MM-dd" android:inputType="date"
                android:textSize="14sp" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnNextDay" android:layout_width="wrap_content"
                android:layout_height="48dp" android:background="@drawable/bg_btn_white_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="后一天 ›" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnLoad" android:layout_width="wrap_content"
                android:layout_height="48dp" android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_primary_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="加载" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/white" />
        </LinearLayout>
        <TextView android:id="@+id/tvDates" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textSize="12sp" android:textColor="@color/text_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnDownload" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp"
                android:background="@drawable/bg_btn_white_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="下载本条" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/text_primary" />
            <Button android:id="@+id/btnDeleteLocal" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1" android:layout_margin="4dp"
                android:background="@drawable/bg_btn_white_capsule"
                android:minWidth="0dp" android:minHeight="0dp"
                android:text="删除本地文件" android:textSize="14sp"
                android:textAllCaps="false" android:textColor="@color/text_primary" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRecords"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="8dp"
            android:clipToPadding="false" android:paddingTop="2dp" android:paddingBottom="2dp" />
    </LinearLayout>
</LinearLayout>
