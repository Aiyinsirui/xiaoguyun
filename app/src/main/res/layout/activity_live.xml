<?xml version="1.0" encoding="utf-8"?>
<!-- v1.2.0: the video container sits ABOVE the ScrollView (not inside it).
     v1.1.6 proved a SurfaceView inside a ScrollView shows black on this
     device even though frames are decoded; v1.1.7's TextureView crashed
     because it carried android:background (UnsupportedOperationException).
     The SurfaceView is
     created programmatically and added to videoContainer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/tvTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold" />
    <FrameLayout android:id="@+id/videoContainer" android:layout_width="match_parent"
        android:layout_height="220dp" android:layout_marginTop="12dp"
        android:background="#000000" android:gravity="center" />
    <ScrollView android:id="@+id/scrollControls" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/tvLiveStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/connecting" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="画面与声音"
                android:textColor="#888888" android:textSize="13sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <Button android:id="@+id/btnDefinition" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="流畅" />
                <Button android:id="@+id/btnMute" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/mute" />
                <Button android:id="@+id/btnPlayback" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/playback" />
                <Button android:id="@+id/btnDetail" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="设备详情" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="抓拍与录像"
                android:textColor="#888888" android:textSize="13sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <Button android:id="@+id/btnSnapshot" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="抓拍" />
                <Button android:id="@+id/btnRecord" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="本地录像" />
                <Button android:id="@+id/btnLens" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="切换镜头" />
                <Button android:id="@+id/btnFullscreen" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="全屏" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="云台控制"
                android:textColor="#888888" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="点按转一下，按住连续转；也可以直接在画面上滑动"
                android:textColor="#999999" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <Button android:id="@+id/btnUp" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/ptz_up" />
                <Button android:id="@+id/btnDown" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/ptz_down" />
                <Button android:id="@+id/btnLeft" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/ptz_left" />
                <Button android:id="@+id/btnRight" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/ptz_right" />
            </LinearLayout>
            <Button android:id="@+id/btnResetPtz" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="云台复位（回初始位置）" />
            <Button android:id="@+id/btnTrack" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="智能追踪：查询中…" />
            <Button android:id="@+id/btnFillLight" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="补光灯：查询中…" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="语音对讲"
                android:textColor="#888888" android:textSize="13sp" android:textStyle="bold" />
            <Button android:id="@+id/btnIntercom" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:minHeight="56dp" android:textStyle="bold"
                android:text="@string/intercom" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="按住按钮说话，松开结束；对讲时自动静音直播声音以避免回声"
                android:textColor="#999999" android:textSize="12sp" />
            <Button android:id="@+id/btnRetryLive" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="@string/retry" />
            <Button android:id="@+id/btnCopyAddr" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="复制直播地址（诊断用）" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
